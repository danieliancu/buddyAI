# ola production settings. Copy to deploy/.env (never commit it) and fill in.

# --- Domains (DNS A records -> this server's IP) -----------------------------------------------
ROOT_DOMAIN=example.com
SITE_DOMAIN=www.example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices

# --- Database -------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random   # e.g. openssl rand -base64 32

# --- AI provider ------------------------------------------------------------------------------------
BUDDYAI_AI_PROFILE=openai
BUDDYAI_OPENAI_API_KEY=
# BUDDYAI_DASHSCOPE_API_KEY=              # profile "qwen"
# BUDDYAI_AZURE_SPEECH_KEY=
# BUDDYAI_AZURE_SPEECH_REGION=westeurope

# --- Costs shown in the operator app ------------------------------------------------------------------
BUDDYAI_DISPLAY_CURRENCY=GBP
BUDDYAI_USD_TO_DISPLAY_RATE=0.75          # update occasionally (also editable in the app)

# --- Email (verification, password reset, orders) ------------------------------------------------------
BUDDYAI_EMAIL_BACKEND=smtp
BUDDYAI_EMAIL_FROM=ola <hello@example.com>
BUDDYAI_SMTP_HOST=
BUDDYAI_SMTP_PORT=587
BUDDYAI_SMTP_USER=
BUDDYAI_SMTP_PASSWORD=
BUDDYAI_SMTP_STARTTLS=true

# --- Web search ------------------------------------------------------------------------------------
# legacy_openai (OpenAI hosted search) or ddgs_brave (our own: about 70% cheaper; see websearch-todo.md).
# With ddgs_brave, the categories in SEARCH_LEGACY_CATEGORIES still use hosted search (live transport).
# Before switching on: credit "Weather data: MET Norway (CC BY 4.0)" and "© OpenStreetMap contributors" on the site.
BUDDYAI_SEARCH_BACKEND=legacy_openai
BUDDYAI_BRAVE_API_KEY=
BUDDYAI_BRAVE_MONTHLY_BUDGET_USD=5
BUDDYAI_SEARCH_LEGACY_CATEGORIES=transport
BUDDYAI_WEATHER_SOURCE=metno
BUDDYAI_SEARCH_GIVE_UP_S=6

# --- Stripe (shop + ola Care subscription) -------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to keep the shop closed (every watch is then entitled).
BUDDYAI_STRIPE_SECRET_KEY=
BUDDYAI_STRIPE_WEBHOOK_SECRET=
BUDDYAI_STRIPE_PRICE_WATCH_GBP=
BUDDYAI_STRIPE_PRICE_WATCH_EUR=
BUDDYAI_STRIPE_PRICE_CARE_GBP=
BUDDYAI_STRIPE_PRICE_CARE_EUR=
BUDDYAI_STRIPE_SHIPPING_RATES_GBP=         # comma-separated shipping rate ids
BUDDYAI_STRIPE_SHIPPING_RATES_EUR=
BUDDYAI_CARE_TRIAL_DAYS=30                 # free trial, started when the watch is paired (not at purchase)
# Local tests only (ignored with sk_live_ keys): checkout without Stripe Tax / without a ToS URL.
# BUDDYAI_STRIPE_AUTOMATIC_TAX=false
# BUDDYAI_STRIPE_REQUIRE_TOS=false
# Test first: sk_test_ keys, test price ids and the test webhook secret (deploy/README.md section 6).
# Plan prices / allowances / usage thresholds: operator web app (Usage > Plan settings), not env.

# --- Backups (see deploy/README.md section 8) ------------------------------------------------------------
# Empty = today's behaviour: a verified daily dump (+ .sha256) in deploy/backups/, kept 14 days, on this server only.
# (Comments stay on their own lines: after an empty value, "# ..." would become the value.)
# age PUBLIC key "age1..." (several: comma-separated). Never the private key.
BACKUP_AGE_RECIPIENT=
# Off-site rclone remote:path, e.g. offsite:buddyai-backups. Uploads only when BACKUP_AGE_RECIPIENT is set.
BACKUP_RCLONE_REMOTE=
# base64 of an rclone.conf; or put RCLONE_CONFIG_<REMOTE>_* lines in deploy/backup.env (never committed).
BACKUP_RCLONE_CONFIG_B64=
# Off-site retention in days (empty = 30), local retention in days (empty = 14).
BACKUP_REMOTE_KEEP_DAYS=
BACKUP_LOCAL_KEEP_DAYS=
# Seconds between backups (empty = 86400).
BACKUP_INTERVAL_S=
# 1 = also back up the serverdata volume (cookie secret key, provider keys, firmware images).
BACKUP_SERVERDATA=

# --- Long-term memory (see deploy/README.md "Memory") ------------------------------------------------------
# BUDDYAI_MEMORY_ENABLED=true             # "remember that...", recall, the Memory page (false = off for everyone)
# BUDDYAI_MEMORY_ACCOUNTS=                # comma-separated account ids during rollout; empty = everyone
# BUDDYAI_MEMORY_EMBEDDINGS_ENABLED=false # vectors (needs the pgvector database image + migration 0022)
# BUDDYAI_MEMORY_VECTOR_RETRIEVAL=false   # semantic recall for accounts with many memories
# BUDDYAI_MEMORY_INFERENCE_ENABLED=true   # learn facts from conversations (each account can switch it off)
