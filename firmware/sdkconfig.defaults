# BuddyAI watch firmware - default configuration
# Board: Waveshare ESP32-S3-Touch-AMOLED-2.06 (ESP32-S3R8, 8 MB octal PSRAM, 32 MB flash)
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash / partitions ----------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- CPU / RTOS --------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- PSRAM (octal, 80 MHz) ------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ---- Networking ------------------------------------------------------------
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Free internal RAM for the Wi-Fi driver: voice traffic does not need the IRAM
# throughput optimisations, and 8 static RX buffers are plenty
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8

# ---- Bluetooth LE Wi-Fi setup (components/ble_prov) --------------------------
# NimBLE host, peripheral only, one connection; it runs only while the watch is in
# Wi-Fi setup. Its memory goes to PSRAM: internal RAM is scarce (see above).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set
# Setup sessions: security scheme 2 only (SRP6a + AES-256-GCM); no unauthenticated
# or weaker scheme can be negotiated.
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0 is not set
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1 is not set
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y

# ---- TLS: wss:// and https OTA with the Mozilla CA bundle ------------------
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Development only: allows http:// OTA URLs on a LAN server. Disable in M5
# (production requires https + signature).
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# ---- LVGL 9 ------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates through the C library -> large objects land in PSRAM
CONFIG_LV_USE_CLIB_MALLOC=y
# development builds serve the screen as an image (main/debug_snap.c)
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
# Internal RAM is scarce (Wi-Fi, DMA, task stacks): keep LVGL code in flash
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
# Wi-Fi setup screen: QR code that joins the "ola-XXXX" setup network from a phone camera
CONFIG_LV_USE_QRCODE=y
# Characters the fonts lack (CJK, Arabic, emoji...) are skipped instead of drawn as empty boxes
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_SYSMON=n

# ---- Logging ----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
