menu "BuddyAI"

    config BUDDYAI_RELEASE_BUILD
        bool "Release (production) build"
        default n
        help
            Set by sdkconfig.release. Hardens the firmware for customer units:
            the setup portal has no Server URL field, the watch connects only
            to BUDDYAI_DEFAULT_SERVER_URL (wss://), and OTA URLs must be
            https://.
            Development builds (default) keep plain ws:// / http:// for a LAN
            server.

    config BUDDYAI_DEFAULT_SERVER_URL
        string "Default server URL"
        default ""
        help
            Development builds: WebSocket URL used when no server_url was
            configured through the SoftAP portal, e.g.
            ws://192.168.1.10:8765/ws/device (empty: last-known server or mDNS).
            Release builds: the only server the watch connects to (set in
            sdkconfig.release, must be wss://).

    config BUDDYAI_HW_MODEL
        string "Hardware model string sent in hello"
        default "waveshare-esp32-s3-touch-amoled-2.06"

    config BUDDYAI_MDNS_DISCOVERY
        bool "Enable mDNS _buddyai._tcp discovery"
        default y
        help
            Optional convenience discovery for LAN development. The firmware
            works fully without it.

    config BUDDYAI_LOW_BATTERY_PCT
        int "Low battery warning threshold (%)"
        range 1 30
        default 5

    config BUDDYAI_PM_MIN_FREQ_MHZ
        int "CPU frequency in standby (MHz)"
        depends on PM_ENABLE
        range 40 240
        default 80
        help
            While the screen is in standby the CPU runs at this frequency;
            awake (and during every conversation) it runs at full speed.
            80 MHz keeps the Wi-Fi/TLS link comfortable.

    config BUDDYAI_PM_LIGHT_SLEEP
        bool "Automatic light sleep in standby (experimental)"
        depends on PM_ENABLE && FREERTOS_USE_TICKLESS_IDLE
        default n
        help
            Lets the CPU sleep between Wi-Fi beacons in standby: the I2S
            audio port stops while the screen is in standby and the LVGL
            tick reads the clock instead of a 5 ms timer. Not yet tested on
            the watch: check touch wake-up, the first sound of a reply and
            Wi-Fi stability before enabling it (firmware/README.md
            "Measuring power").

    config BUDDYAI_STANDBY_DISPLAY_OFF
        bool "Switch the display off in standby (power measurement only)"
        depends on !BUDDYAI_RELEASE_BUILD
        default n
        help
            Scenario C of the power measurement: the panel switches off
            instead of dimming to the standby brightness. Customers' watches
            keep the standby screen on.

endmenu
