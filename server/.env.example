# Copy to .env. Keys can also be set from the web UI (stored in data/provider_keys.json).
BUDDYAI_HOST=0.0.0.0
BUDDYAI_PORT=8765
# BUDDYAI_DATABASE_URL=sqlite:///./data/buddyai.db
# BUDDYAI_PUBLIC_URL=http://192.168.1.10:8765   # used in OTA links; auto-detected when empty
BUDDYAI_MDNS_ENABLED=true
# Set to true to run the whole pipeline with offline mock providers (no API keys needed).
BUDDYAI_MOCK_PROVIDERS=false

# AI provider profile -> config/providers.<profile>.json  (openai | qwen)
BUDDYAI_AI_PROFILE=openai

# OpenAI (profile "openai")
BUDDYAI_OPENAI_API_KEY=
# BUDDYAI_OPENAI_BASE_URL=https://api.openai.com/v1
# BUDDYAI_OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime?intent=transcription

# Alibaba Model Studio (profile "qwen", international / Singapore)
BUDDYAI_DASHSCOPE_API_KEY=
# BUDDYAI_DASHSCOPE_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# BUDDYAI_DASHSCOPE_ASR_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference
# BUDDYAI_DASHSCOPE_REALTIME_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime

# Azure Speech (Romanian TTS in profile "qwen")
BUDDYAI_AZURE_SPEECH_KEY=
BUDDYAI_AZURE_SPEECH_REGION=westeurope
