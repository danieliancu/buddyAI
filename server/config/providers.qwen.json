{
  "supported_languages": [
    "zh",
    "en",
    "de",
    "it",
    "pt",
    "es",
    "ja",
    "ko",
    "fr",
    "ru",
    "ro"
  ],
  "stt": {
    "default": {
      "provider": "qwen_asr",
      "model": "qwen-audio-3.1-asr-flash-streaming"
    },
    "by_language": {}
  },
  "llm": {
    "default_model": "qwen-flash",
    "models": [
      {
        "id": "qwen-flash",
        "provider": "qwen",
        "label": "Qwen Flash (fast, low cost)"
      },
      {
        "id": "qwen-plus",
        "provider": "qwen",
        "label": "Qwen Plus (higher quality)"
      }
    ],
    "params": {
      "temperature": 0.7,
      "enable_thinking": false
    }
  },
  "tts": {
    "default": {
      "provider": "qwen_tts",
      "model": "qwen3-tts-flash-realtime",
      "voices": [
        "Cherry",
        "Ethan",
        "Serena",
        "Chelsie"
      ],
      "default_voice": "Cherry"
    },
    "by_language": {
      "ro": {
        "provider": "azure_tts",
        "model": "azure-neural",
        "voices": [
          "ro-RO-AlinaNeural",
          "ro-RO-EmilNeural"
        ],
        "default_voice": "ro-RO-AlinaNeural"
      }
    }
  },
  "audio": {
    "downlink_rate_preferred": 24000,
    "opus_uplink_bitrate": 24000,
    "opus_downlink_bitrate": 32000
  },
  "chunker": {
    "min_chars": 80,
    "first_chunk_min_chars": 20,
    "soft_max_chars": 160,
    "hard_max_chars": 240,
    "idle_flush_ms": 300,
    "idle_min_chars": 20
  },
  "embedding": {
    "provider": "qwen_embed",
    "model": "text-embedding-v4",
    "dimensions": 512
  },
  "pricing_defaults": [
