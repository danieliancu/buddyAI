{
  "supported_languages": [
    "zh",
    "en",
    "de",
    "it",
    "pt",
    "es",
    "ja",
    "ko",
    "fr",
    "ru",
    "ro"
  ],
  "stt": {
    "default": {
      "provider": "qwen_asr",
      "model": "qwen-audio-3.1-asr-flash-streaming"
    },
    "by_language": {}
  },
  "llm": {
    "default_model": "qwen-flash",
    "models": [
      {
        "id": "qwen-flash",
        "provider": "qwen",
        "label": "Qwen Flash (fast, low cost)"
      },
      {
        "id": "qwen-plus",
        "provider": "qwen",
        "label": "Qwen Plus (higher quality)"
      }
    ],
    "params": {
      "temperature": 0.7,
      "enable_thinking": false
    }
  },
  "tts": {
    "default": {
      "provider": "qwen_tts",
      "model": "qwen3-tts-flash-realtime",
      "voices": [
        "Cherry",
        "Ethan",
        "Serena",
        "Chelsie"
      ],
      "default_voice": "Cherry"
    },
    "by_language": {
      "ro": {
        "provider": "azure_tts",
        "model": "azure-neural",
        "voices": [
          "ro-RO-AlinaNeural",
          "ro-RO-EmilNeural"
        ],
        "default_voice": "ro-RO-AlinaNeural"
      }
    }
  },
  "audio": {
    "downlink_rate_preferred": 24000,
    "opus_uplink_bitrate": 24000,
    "opus_downlink_bitrate": 32000
  },
  "chunker": {
    "min_chars": 80,
    "first_chunk_min_chars": 20,
    "soft_max_chars": 160,
    "hard_max_chars": 240,
    "idle_flush_ms": 300,
    "idle_min_chars": 20
  },
  "embedding": {
    "provider": "qwen_embed",
    "model": "text-embedding-v4",
    "dimensions": 512
  },
  "pricing_defaults": [
    {
      "provider": "qwen_embed",
      "model": "text-embedding-v4",
      "unit": "input_token",
      "price_usd": 7e-08,
      "note": "Model Studio Singapore estimate. Verify in the console."
    },
    {
      "provider": "qwen_asr",
      "model": "qwen-audio-3.1-asr-flash-streaming",
      "unit": "audio_second",
      "price_usd": 2.33e-05,
      "note": "Estimate from $0.93/1M input tokens (Singapore) at ~25 audio tokens/s. Verify in Model Studio console."
    },
    {
      "provider": "qwen",
      "model": "qwen-flash",
      "unit": "input_token",
      "price_usd": 1.5e-07,
      "note": "Model Studio Singapore, Sep 2026. Verify."
    },
    {
      "provider": "qwen",
      "model": "qwen-flash",
      "unit": "output_token",
      "price_usd": 4.7e-07,
      "note": "Model Studio Singapore, Sep 2026. Verify."
    },
    {
      "provider": "qwen",
      "model": "qwen-plus",
      "unit": "input_token",
      "price_usd": 4e-07,
      "note": "Model Studio Singapore, Sep 2026. Verify."
    },
    {
      "provider": "qwen",
      "model": "qwen-plus",
      "unit": "output_token",
      "price_usd": 1.6e-06,
      "note": "Model Studio Singapore, Sep 2026. Verify."
    },
    {
      "provider": "qwen_tts",
      "model": "qwen3-tts-flash-realtime",
      "unit": "character",
      "price_usd": 1.3e-05,
      "note": "Placeholder estimate. Verify in Model Studio console."
    },
    {
      "provider": "azure_tts",
      "model": "azure-neural",
      "unit": "character",
      "price_usd": 1.5e-05,
      "note": "Azure Neural TTS pay-as-you-go ($15/1M chars); first 0.5M chars/month free on F0."
    },
    {
      "provider": "ddgs",
      "model": "web",
      "unit": "search_request",
      "price_usd": 0.0,
      "note": "DDGS metasearch: no per-request charge (hosting and the answering model's tokens are counted apart)."
    },
    {
      "provider": "ddgs",
      "model": "web",
      "unit": "failed_request",
      "price_usd": 0.0,
      "note": "DDGS request that failed (timeout, block, rate limit): counted, no charge."
    },
    {
      "provider": "ddgs",
      "model": "web",
      "unit": "irrelevant_result",
      "price_usd": 0.0,
      "note": "DDGS round with no relevant result: counted, no charge."
    },
    {
      "provider": "brave",
      "model": "web",
      "unit": "search_request",
      "price_usd": 0.005,
      "note": "Brave Search API, $5 / 1k requests (Search plan, 2026). Verify against the Brave dashboard."
    },
    {
      "provider": "brave",
      "model": "web",
      "unit": "failed_request",
      "price_usd": 0.0,
      "note": "Brave request that failed (error / rate limit): counted; assumed not billed. Verify."
    },
    {
      "provider": "trafilatura",
      "model": "extract",
      "unit": "page",
      "price_usd": 0.0,
      "note": "Web page read for a search (download + Trafilatura on our server): no provider charge."
    },
    {
      "provider": "buddyai",
      "model": "websearch",
      "unit": "search_run",
      "price_usd": 0.0,
      "note": "A web_search call that missed the cache (ddgs_brave backend): counted, no charge."
    },
    {
      "provider": "buddyai",
      "model": "websearch",
      "unit": "search_answered",
      "price_usd": 0.0,
      "note": "ddgs_brave search that found an answer: counted, no charge."
    },
    {
      "provider": "buddyai",
      "model": "websearch",
      "unit": "duration_ms",
      "price_usd": 0.0,
      "note": "Wall-clock time of ddgs_brave searches (for latency figures): no charge."
    },
    {
      "provider": "metno",
      "model": "weather",
      "unit": "request",
      "price_usd": 0.0,
      "note": "MET Norway forecast / sunrise API (free, CC BY 4.0, attribution 'MET Norway'): counted, no charge."
    },
    {
      "provider": "nominatim",
      "model": "geocode",
      "unit": "request",
      "price_usd": 0.0,
      "note": "Nominatim (OpenStreetMap) town lookup for the weather source, cached: counted, no charge."
    }
  ]
}
