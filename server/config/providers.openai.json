{
  "supported_languages": "all",
  "stt": {
    "prompt": "Write numbers, amounts, times, dates, measurements and calculations with digits and symbols (15 × 3, 2 + 2, 14:30, £3.50, 21°C, 10%), but keep words like 'one of them' or 'o dată' as spoken.",
    "default": {
      "provider": "openai_stt",
      "model": "gpt-live-transcribe"
    },
    "by_language": {}
  },
  "llm": {
    "default_model": "gpt-6-luna",
    "models": [
      {
        "id": "gpt-6-luna",
        "provider": "openai",
        "label": "GPT-6 Luna (fast, low cost)"
      },
      {
        "id": "gpt-6-sol",
        "provider": "openai",
        "label": "GPT-6 Sol (higher quality)"
      }
    ],
    "params": {
      "reasoning_effort": "none"
    },
    "web_search": {
      "search_context_size": "low",
      "cache_ttl_s": {
        "weather": 900,
        "transport": 120,
        "sport": 600,
        "news": 1800,
        "business": 86400,
        "other": 3600
      }
    }
  },
  "tts": {
    "default": {
      "provider": "openai_tts",
      "model": "gpt-4o-mini-tts",
      "voices": [
        "marin",
        "cedar",
        "coral",
        "nova",
        "alloy",
        "ash",
        "sage",
        "verse"
      ],
      "default_voice": "marin",
      "instructions": "Speak the text in its own language with a natural native accent and intonation. Warm, friendly, relaxed conversational pace."
    },
    "by_language": {}
  },
  "audio": {
    "downlink_rate_preferred": 24000,
    "opus_uplink_bitrate": 24000,
    "opus_downlink_bitrate": 32000
  },
  "chunker": {
    "min_chars": 80,
    "first_chunk_min_chars": 20,
    "soft_max_chars": 160,
    "hard_max_chars": 240,
    "idle_flush_ms": 300,
    "idle_min_chars": 20
  },
  "embedding": {
    "provider": "openai_embed",
    "model": "text-embedding-3-small",
    "dimensions": 512
  },
  "pricing_defaults": [
    {
      "provider": "openai_embed",
      "model": "text-embedding-3-small",
      "unit": "input_token",
      "price_usd": 2e-08,
      "note": "$0.02 / 1M tokens (OpenAI). Verify."
    },
    {
      "provider": "openai_stt",
      "model": "gpt-live-transcribe",
      "unit": "audio_second",
      "price_usd": 0.00028333,
      "note": "$0.017 per minute (OpenAI, Sep 2026). Verify."
    },
    {
      "provider": "openai",
      "model": "gpt-6-luna",
      "unit": "input_token",
      "price_usd": 1e-07,
      "note": "$0.10 / 1M input tokens (OpenAI, Sep 2026). Verify."
    },
    {
      "provider": "openai",
      "model": "gpt-6-luna",
      "unit": "output_token",
      "price_usd": 5e-07,
      "note": "$0.50 / 1M output tokens (OpenAI, Sep 2026). Verify."
    },
    {
      "provider": "openai",
      "model": "gpt-6-luna",
      "unit": "web_search_call",
      "price_usd": 0.01,
      "note": "$10 / 1k web search calls (reasoning models, OpenAI, Sep 2026); search content is billed as input tokens. Verify."
    },
    {
      "provider": "openai",
      "model": "gpt-6-sol",
      "unit": "web_search_call",
      "price_usd": 0.01,
      "note": "$10 / 1k web search calls (reasoning models, OpenAI, Sep 2026); search content is billed as input tokens. Verify."
    },
    {
      "provider": "openai_tts",
      "model": "gpt-4o-mini-tts",
      "unit": "character",
      "price_usd": 1.67e-05,
      "note": "Estimate: ~$0.015 per audio minute ≈ 900 characters. Verify."
    },
    {
      "provider": "openai",
      "model": "gpt-6-luna",
      "unit": "cached_input_token",
      "price_usd": 1e-08,
      "note": "Cached input tokens, assumed 10% of $0.10 / 1M (OpenAI prompt caching). Verify."
    },
    {
      "provider": "openai_stt",
      "model": "gpt-4o-mini-transcribe",
      "unit": "audio_second",
      "price_usd": 5e-05,
      "note": "Fallback transcription: $0.003 per minute (OpenAI). Verify."
    },
    {
      "provider": "buddyai",
      "model": "search_cache",
      "unit": "cache_hit",
      "price_usd": 0.0,
      "note": "Web search answered from the ola cache: no provider cost (counts hits)."
    }
  ]
}
