---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Brand from "../components/Brand.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Designed from "../components/Designed.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import { languageCount, languageCountLabel } from "../lib/languages";
import { privacyLine } from "../data/features";
import { prices } from "../config";

const specs: [string, string][] = [
  ["Display", "AMOLED touch screen, 410 × 502 pixels, rectangular"],
  ["Audio", "Built-in microphones and speaker"],
  ["Connectivity", "Wi-Fi (2.4 GHz). No mobile/cellular connection."],
  ["Updates", "Firmware updates over the air"],
  ["Languages", `${languageCount} languages + Auto (answers in the language you speak)`],
  ["Battery life", "We'll publish measured figures before shipping"],
  ["Size, weight & water resistance", "We'll publish them before shipping"],
  ["What you need", `2.4 GHz Wi-Fi with internet access, a web browser for setup (no app to install), an olá account and an olácare subscription (free ${prices.trialMonths}-month subscription included)`],
];

// Example commands only (not recordings of real conversations); every one maps to something the assistant can do.
const examples = [
  "“Remind me tomorrow at 9:30 to call the dentist.”",
  "“Remind me on Friday at 6 to pick up Sam, and alert me 15 minutes before.”",
  "“Make a shopping list: eggs, bread, oat milk.”",
  "“Add apples to my shopping list.”",
  "“Move my meeting with Anna to 3 pm.”",
  "“What reminders do I have on Monday?”",
  "“Copy my packing list.”",
  "“Delete the gym reminder.” — olá asks you to confirm first.",
];
const offline = {
  works: [
    "The clock",
    "Notes and reminders the watch has already loaded stay on screen",
  ],
  needs: [
    "Talking to the assistant and live answers",
    "Reminder alerts — our servers send them to the watch when they're due (missed ones from the last 24 hours arrive when it reconnects)",
    "Opening a note's full text, marking a reminder done, deleting or pinning",
    "Changes you make in your olá account reaching the watch",
  ],
};
---
<Base
  title="Features: AI voice assistant, reminders, notes & live answers"
  crumb="Features"
  description={`What the olácompanion AI smartwatch does: natural voice conversation, reminders and notes by voice, live answers from the web, ${languageCountLabel} languages, personas and a blue or white theme.`}
>
  <PageHero
    eyebrow="Features"
    title="Everything it does,"
    gradient="honestly explained."
    fitEm={10.2}
  >
    <p class="mt-5 max-w-2xl text-lg text-muted">
      <Brand name="watch" /> is an AI you can talk to, right on your wrist — with reminders, notes and live answers built in.
      Here's exactly what it can do today.
    </p>
  </PageHero>

  <section class="container-x mt-6" aria-labelledby="core-title">
    <h2 id="core-title" class="sr-only">Core features</h2>
    <FeatureGrid detailed />
  </section>

  <section class="container-x mt-20 grid gap-8 lg:grid-cols-2" aria-label="Notes, reminders and connectivity">
    <div class="glass p-6 sm:p-8">
      <h2 id="voice-title" class="text-xl font-semibold text-fg">Notes &amp; reminders, by voice</h2>
      <p class="mt-2 text-muted">
        Create, find, change, copy and delete notes and reminders just by asking. If more than one matches, olá asks which
        one you mean. In a conversation, it asks you to confirm before deleting anything. Up to 100 notes and 100
        reminders per account, also editable in your olá account.
      </p>
      <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-muted">Example commands</h3>
      <ul class="mt-2 space-y-1.5 text-sm text-fg">
        {examples.map((e) => <li class="flex gap-2"><Icon name="mic" size={16} class="mt-0.5 shrink-0 text-accent" />{e}</li>)}
      </ul>
    </div>
    <div class="glass p-6 sm:p-8">
      <h2 id="wifi-title" class="text-xl font-semibold text-fg">What needs Wi-Fi</h2>
      <p class="mt-2 text-muted">
        <Brand name="watch" /> connects over 2.4 GHz Wi-Fi (home, office or a phone hotspot). It has no mobile connection,
        and there is no phone app: setup and your account are in a web browser.
      </p>
      <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-muted">Works without a connection</h3>
      <ul class="mt-2 space-y-1.5 text-sm text-muted">
        {offline.works.map((t) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-ok" />{t}</li>)}
      </ul>
      <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-muted">Needs a connection</h3>
      <ul class="mt-2 space-y-1.5 text-sm text-muted">
        {offline.needs.map((t) => <li class="flex gap-2"><Icon name="wifi" size={16} class="mt-0.5 shrink-0 text-accent" />{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="container-x mt-20" aria-labelledby="privacy-title">
    <div class="glass grid gap-6 p-6 sm:p-8 md:grid-cols-[auto_1fr]">
      <span class="icon-tile"><Icon name="lock" /></span>
      <div>
        <h2 id="privacy-title" class="text-xl font-semibold text-fg">Privacy, in plain words</h2>
        <p class="mt-2 text-muted">{privacyLine}</p>
        <p class="mt-2 text-sm text-muted">AI can make mistakes — please double-check anything important.</p>
      </div>
    </div>
  </section>

  <div class="mt-20"><Designed cta={false} /></div>

  <section class="container-x mt-20" aria-labelledby="specs-title">
    <SectionHeading id="specs-title" title="Specifications" subtitle="Figures we haven't measured yet are marked — we'll publish them before shipping." />
    <dl class="mt-8 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
      {specs.map(([k, v]) => (
        <div class="grid gap-1 p-4 sm:grid-cols-[14rem_1fr] sm:gap-6 sm:px-6">
          <dt class="font-semibold text-fg">{k}</dt>
          <dd class="text-muted">{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="container-x mt-16 text-center">
    <a href="/pricing/#buy" class="btn btn-primary">See pricing <Icon name="arrow" size={18} /></a>
  </section>
</Base>
