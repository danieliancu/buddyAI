---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import WatchMock from "../components/WatchMock.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Steps from "../components/Steps.astro";
import UseCases from "../components/UseCases.astro";
import Designed from "../components/Designed.astro";
import Testimonials from "../components/Testimonials.astro";
import BuyBox from "../components/BuyBox.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Price from "../components/Price.astro";
import { languageCountLabel } from "../lib/languages";
import { privacyLine } from "../data/features";
import { config, prices } from "../config";

const description = `BuddyAI is a smartwatch with an AI voice assistant built in. Tap the mic, talk naturally, and hear a reply in ${languageCountLabel} languages. Ships to the UK and EU.`;
const site = Astro.site!;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: config.siteName,
    url: site.href,
    logo: new URL("/favicon.svg", site).href,
    email: config.supportEmail,
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "BuddyAI Watch",
    description,
    brand: { "@type": "Brand", name: config.siteName },
    offers: [
      { "@type": "Offer", priceCurrency: "GBP", price: prices.watch.GBP, url: new URL("/pricing/", site).href },
      { "@type": "Offer", priceCurrency: "EUR", price: prices.watch.EUR, url: new URL("/pricing/", site).href },
    ],
  },
];
---
<Base title="Your AI companion, now on your wrist" description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="container-x grid items-center gap-10 pb-12 pt-12 sm:pt-16 lg:grid-cols-[1.25fr_1fr] lg:pb-20">
      <div>
        <h1 id="hero-title" class="text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
          Your AI companion,<br /><span class="text-gradient">now on your wrist.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted">
          Just talk. BuddyAI is a smartwatch with an AI voice assistant built in — tap the mic, ask anything, and hear a
          natural reply in {languageCountLabel} languages.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/pricing/#buy" class="btn btn-primary text-base">Buy now <Icon name="arrow" size={18} /></a>
          <a href="/how-it-works/" class="btn btn-ghost text-base">See how it works</a>
        </div>
        <p class="mt-4 text-sm text-muted">
          <Price item="watch" class="font-semibold text-white" /> today, then <Price item="care" />/month for BuddyAI Care
          after {prices.trialMonths} months free. Cancel anytime.
        </p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
          <li class="flex items-center gap-2"><Icon name="undo" size={18} class="text-violet" /> 14-day right to cancel</li>
          <li class="flex items-center gap-2"><Icon name="shield" size={18} class="text-violet" /> 2-year EU guarantee · UK statutory rights</li>
          <li class="flex items-center gap-2"><Icon name="truck" size={18} class="text-violet" /> Ships to the UK &amp; EU</li>
        </ul>
      </div>
      <WatchMock id="hero-watch" class="w-56 sm:w-64 lg:w-72" />
    </div>
  </section>

  <!-- Features -->
  <section class="container-x" aria-labelledby="features-title">
    <h2 id="features-title" class="sr-only">Features</h2>
    <FeatureGrid />
  </section>

  <!-- How it works -->
  <section class="container-x mt-24" aria-labelledby="how-title">
    <SectionHeading id="how-title" title="How BuddyAI works" subtitle="Get started in three simple steps." />
    <div class="mt-8"><Steps /></div>
  </section>

  <!-- Use cases -->
  <section class="container-x mt-24" aria-labelledby="uses-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        id="uses-title"
        title="A smarter everyday"
        subtitle="Whether you're curious, learning, busy or brainstorming, BuddyAI is one tap away."
      />
      <a href="/features/" class="link text-sm font-semibold">All features</a>
    </div>
    <div class="mt-8"><UseCases /></div>
  </section>

  <Designed />

  <Testimonials />

  <!-- Privacy strip -->
  <section class="container-x mt-24" aria-labelledby="privacy-title">
    <div class="glass flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:p-8">
      <span class="icon-tile shrink-0"><Icon name="lock" /></span>
      <div>
        <h2 id="privacy-title" class="text-lg font-semibold text-white">Your conversations, your control</h2>
        <p class="mt-1 text-muted">{privacyLine}</p>
      </div>
    </div>
  </section>

  <!-- Buy -->
  <section class="container-x mt-24" aria-labelledby="buy-title">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <p class="eyebrow">BuddyAI Watch</p>
        <h2 id="buy-title" class="mt-1 text-3xl font-bold tracking-tight text-white sm:text-4xl">Get your BuddyAI</h2>
        <p class="mt-4 max-w-md text-muted">
          One price for the watch, then a simple monthly subscription for the AI — with the first {prices.trialMonths}
          months free.
        </p>
        <WatchMock id="buy-watch" class="mt-8 hidden w-44 lg:block" />
      </div>
      <BuyBox headingLevel="h3" />
    </div>
  </section>
</Base>
