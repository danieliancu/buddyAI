---
import Brand from "../components/Brand.astro";
import HeroChat from "../components/HeroChat.astro";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Highlights from "../components/Highlights.astro";
import HowSimulator from "../components/how/HowSimulator.astro";
import UseCases from "../components/UseCases.astro";
import Designed from "../components/Designed.astro";
import Testimonials from "../components/Testimonials.astro";
import BuyBox from "../components/BuyBox.astro";
import { languageCount } from "../lib/languages";
import { config, prices, formatPrice, shipCountryCodes } from "../config";
import heroWatch from "../assets/home/hero-watch.png";
import watchBox from "../assets/home/watch-box.png";

const description = `olácompanion: your AI companion & personal assistant on your wrist. Tap the mic, talk naturally, set reminders, check Google or Outlook Calendar, send notes to email and get live answers in ${languageCount} languages. ${formatPrice(prices.watch.GBP, "GBP")}, ships within Great Britain.`;
const site = Astro.site!;
const heroImg = await getImage({ src: heroWatch, width: 1200, format: "png" });
const boxImg = await getImage({ src: watchBox, width: 1200, format: "png" });
const offerBase = {
  "@type": "Offer",
  url: new URL("/#buy", site).href,
  itemCondition: "https://schema.org/NewCondition",
  seller: { "@id": new URL("/#organization", site).href },
  hasMerchantReturnPolicy: {
    "@type": "MerchantReturnPolicy",
    applicableCountry: shipCountryCodes,
    returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
    merchantReturnDays: 14,
    returnMethod: "https://schema.org/ReturnByMail",
    returnFees: config.freeReturns ? "https://schema.org/FreeReturn" : "https://schema.org/ReturnFeesCustomerResponsibility",
  },
};
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": new URL("/#product", site).href,
    name: "olácompanion",
    description,
    image: [new URL(heroImg.src, site).href, new URL(boxImg.src, site).href],
    brand: { "@type": "Brand", name: config.siteName },
    manufacturer: { "@id": new URL("/#organization", site).href },
    category: "AI companion & personal assistant watches",
    additionalProperty: [
      { "@type": "PropertyValue", name: "Display", value: "AMOLED touch screen, 410 × 502 pixels" },
      { "@type": "PropertyValue", name: "Connectivity", value: "Wi-Fi (2.4 GHz)" },
      { "@type": "PropertyValue", name: "Integrations", value: "Google Calendar, Microsoft Outlook Calendar, Note to Email" },
      { "@type": "PropertyValue", name: "Languages", value: `${languageCount} + Auto` },
      { "@type": "PropertyValue", name: "Subscription", value: `olácare, ${formatPrice(prices.care.GBP, "GBP")}/month after a free ${prices.trialDays}-day subscription` },
    ],
    offers: [
      { ...offerBase, priceCurrency: "GBP", price: prices.watch.GBP.toFixed(2) },
    ],
  },
];
---
<Base title="Your AI Companion & Personal Assistant" description={description} jsonLd={jsonLd} dark>
  <!-- Black top: the hero (and, on desktop, the six features) down to the bottom of the screen (script at the end) -->
  <div class="relative isolate flex flex-col overflow-hidden bg-black lg:min-h-[calc(100svh-4.1rem)]" data-hero-wrap>
  <!-- Hero -->
  <section class="relative flex-1 text-white max-sm:overflow-hidden lg:flex lg:items-center" aria-labelledby="hero-title">
    <!-- phones: the hero is stretched (by the script at the end) to the bottom of the screen; the watch fills what's left under the buttons -->
    <div class="container-x relative grid w-full items-center gap-3 pb-10 pt-6 max-sm:pb-2 max-sm:flex max-sm:flex-col max-sm:items-stretch sm:gap-6 sm:pt-10 lg:grid-cols-[1.15fr_1fr] lg:pb-6 lg:pt-10" data-hero>
      <div>
        <h1 id="hero-title" style="--fit-em: 10.8" class="fit-title font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[3.4rem]">
          <span class="whitespace-nowrap">Your AI Companion</span><br /><span class="text-gradient-dark whitespace-nowrap">&amp; Personal Assistant</span>
        </h1>
        <p class="mt-3 max-w-xl text-base text-white/80 sm:mt-5 sm:text-lg">
          Talk naturally. Get reminders, take notes, get live answers and more. <Brand name="watch" /> is a wearable AI companion designed to
          make everyday life easier, in {languageCount} languages.
        </p>
        <div class="mt-5 grid gap-3 sm:mt-7 sm:w-fit sm:grid-cols-2">
          <a href="#buy" class="btn btn-primary text-base sm:min-w-48"><span data-when="guest">Buy Now</span><span data-when="customer">Buy again</span> <Icon name="arrow" size={18} /></a>
          <a href="/how-it-works/" class="btn btn-ghost-dark hidden text-base sm:inline-flex sm:min-w-48"><Icon name="play" size={20} class="text-[#8b7bff]" /> How It Works</a>
        </div>
      </div>
      <div class="relative mx-auto w-fit max-sm:mx-0 max-sm:min-h-64 max-sm:w-full max-sm:flex-1 lg:-my-6 xl:-ml-28">
        <!-- a violet glow behind the watch and its reflection on the "floor" -->
        <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 aspect-square w-[115%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,.42),rgba(47,107,255,.14)_55%,transparent)] blur-2xl max-sm:w-[95%]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-[1%] left-1/2 -z-10 h-12 w-[78%] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(closest-side,rgba(139,123,255,.45),transparent)] blur-md" aria-hidden="true"></div>
        <Image
          src={heroWatch}
          alt="The olácompanion (illustration)"
          widths={[360, 560, 760]}
          sizes="(min-width: 1024px) 440px, 80vw"
          loading="eager"
          fetchpriority="high"
          class="w-64 drop-shadow-[0_24px_40px_rgba(91,76,240,.35)] max-sm:absolute max-sm:bottom-0 max-sm:left-1/2 max-sm:h-full max-sm:max-h-[115vw] max-sm:max-w-none max-sm:w-auto max-sm:-translate-x-1/2 sm:w-80 lg:w-[30rem] 2xl:w-[34rem]"
        />
        <!-- phones: a corner ribbon on the watch picture, flush with the screen's right edge (the top bar is hidden here) -->
        <div class="pointer-events-none absolute -right-4 top-0 size-44 overflow-hidden sm:hidden" aria-hidden="true">
          <div class="absolute right-[-3.6rem] top-[2.6rem] w-64 rotate-45 bg-[#ea580c] py-1.5 text-center font-extrabold uppercase leading-tight tracking-wide text-white shadow-[0_4px_10px_rgba(234,88,12,.35)]">
            <span class="block text-sm">Free {prices.trialDays}-day</span><span class="block text-[11px]">subscription</span>
          </div>
        </div>
        <p class="sr-only sm:hidden">Free {prices.trialDays}-day subscription</p>
      </div>
      <!-- the example conversation: only where it fits beside the watch (1440 px and wider), 4-5 bubbles high -->
      <HeroChat class="z-10 hidden min-[1440px]:absolute min-[1440px]:top-1/2 min-[1440px]:h-[19rem] min-[1440px]:-translate-y-1/2 min-[1440px]:-right-24 min-[1440px]:block min-[1440px]:w-[21rem] min-[1760px]:-right-32" />
    </div>
  </section>

  <!-- Features: on the black top on desktop, on white on phones and tablets -->
  <section class="bg-gradient-to-b from-[#f7f8ff] to-white pb-12 pt-6 lg:bg-none lg:bg-transparent lg:pb-8 lg:pt-0" aria-labelledby="features-title">
    <div class="container-x">
      <h2 id="features-title" class="sr-only">Features</h2>
      <Highlights />
    </div>
  </section>
  </div>

  <!-- How it works -->
  <section class="bg-bg-2 py-10" aria-labelledby="how-title">
    <div class="container-x">
      <h2 id="how-title" class="text-2xl font-extrabold tracking-tight text-fg">How it Works</h2>
      <p class="mt-1 text-muted">Get started in just a few simple steps.</p>
      <div class="mt-6"><HowSimulator embedded /></div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="container-x py-12" aria-labelledby="uses-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 id="uses-title" class="text-2xl font-extrabold tracking-tight text-fg sm:text-3xl">A Smarter Everyday, for Everyone</h2>
        <p class="mt-2 text-muted">
          <Brand name="watch" /> is designed for real life. Whether you're a parent, a professional, or just want a little extra
          support, <Brand name="watch" /> is always here to help.
        </p>
      </div>
      <a href="/features/" class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline">See More Use Cases <Icon name="arrow" size={16} /></a>
    </div>
    <div class="mt-6"><UseCases /></div>
  </section>

  <Designed />

  <Testimonials />

  <!-- Buy -->
  <section id="buy" class="relative overflow-hidden bg-bg-2 py-12" aria-labelledby="buy-title">
    <!-- desktop only: faint glowing waves, like the one on the watch face -->
    <svg
      class="pointer-events-none absolute inset-0 hidden h-full w-full opacity-[0.18] lg:block"
      viewBox="0 0 1440 600"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="buy-wave" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#4f8cff" stop-opacity="0" />
          <stop offset="0.25" stop-color="#4f8cff" />
          <stop offset="0.7" stop-color="#5b4cf0" />
          <stop offset="1" stop-color="#5b4cf0" stop-opacity="0" />
        </linearGradient>
        <filter id="buy-wave-glow" x="-10%" y="-50%" width="120%" height="200%">
          <feGaussianBlur stdDeviation="10" />
        </filter>
      </defs>
      <g fill="none" stroke="url(#buy-wave)" stroke-linecap="round">
        <path d="M0 420 C 240 330, 480 330, 720 400 S 1200 500, 1440 380" stroke-width="16" filter="url(#buy-wave-glow)" />
        <path d="M0 420 C 240 330, 480 330, 720 400 S 1200 500, 1440 380" stroke-width="4" />
        <path d="M0 470 C 300 400, 560 420, 800 460 S 1220 520, 1440 440" stroke-width="2.5" opacity="0.7" />
        <path d="M0 360 C 280 290, 520 300, 760 350 S 1180 430, 1440 320" stroke-width="2" opacity="0.5" />
        <path d="M0 520 C 320 470, 600 480, 860 510 S 1240 560, 1440 500" stroke-width="1.5" opacity="0.4" />
      </g>
    </svg>
    <div class="container-x relative grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_21rem]">
      <!-- text on top, the watch-and-box picture under it; the buy box beside them -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
        <p class="eyebrow">Get yours</p>
        <h2 id="buy-title" class="mt-1 text-3xl font-extrabold tracking-tight text-fg">Put it on Your Wrist</h2>
        <p class="mt-3 max-w-md text-muted">
          Get your <Brand name="watch" /> and be part of the next generation of AI-powered wearables.
        </p>
        <ul class="mt-5 hidden flex-wrap gap-x-5 gap-y-2 text-sm text-fg lg:flex">
          <li class="flex items-center gap-2"><Icon name="rocket" size={18} class="text-accent" /> Early Access</li>
          <li class="flex items-center gap-2"><Icon name="gift" size={18} class="text-accent" /> <span>Free {prices.trialDays}-day <Brand name="care" /> subscription</span></li>
          <li class="flex items-center gap-2"><Icon name="truck" size={18} class="text-accent" /> Ships within Great Britain</li>
        </ul>
        <Image
          src={watchBox}
          alt="The olácompanion next to its box (illustration)"
          widths={[320, 520, 700]}
          sizes="(min-width: 1024px) 520px, 80vw"
          class="mx-auto mt-6 w-72 lg:mx-0 lg:h-[340px] lg:!w-auto lg:max-w-full lg:object-contain"
        />
      </div>
      <BuyBox headingLevel="h3" compact anchor={false} />
    </div>
  </section>
</Base>

<script>
  // Offer availability follows the live shop status (/api/shop/status): only when checkout is open for a
  // currency does its Offer say InStock. Closed, unreachable or not configured: no availability at all
  // (never OutOfStock, which would be untrue). Matches the buy box, which uses the same status.
  import { shopStatus } from "../lib/shop";

  shopStatus().then((s) => {
    if (!s.open) return;
    for (const el of document.querySelectorAll<HTMLScriptElement>('script[type="application/ld+json"]')) {
      let data: unknown;
      try {
        data = JSON.parse(el.textContent || "");
      } catch {
        continue;
      }
      const items = Array.isArray(data) ? data : [data];
      let changed = false;
      for (const item of items as { "@type"?: string; offers?: { priceCurrency?: string; availability?: string }[] }[]) {
        if (item["@type"] !== "Product" || !Array.isArray(item.offers)) continue;
        for (const offer of item.offers) {
          if (offer.priceCurrency && s.currencies.includes(offer.priceCurrency.toLowerCase())) {
            offer.availability = "https://schema.org/InStock";
            changed = true;
          }
        }
      }
      if (changed) el.textContent = JSON.stringify(data);
    }
  });
</script>

<script>
  // Phones: on load the hero is stretched to the bottom of the screen; the watch, which fills the space
  // under the buttons, grows with it. Measured once on load, again only when the width changes (a
  // rotation), so the hero doesn't jump as the phone's address bar shows/hides.
  // Desktop: the black top (hero + the six features) reaches the bottom of the screen the same way.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const wrap = document.querySelector<HTMLElement>("[data-hero-wrap]");
  const phone = matchMedia("(max-width: 639.98px)");
  const desktop = matchMedia("(min-width: 1024px)");

  // The header is black over the black top, white once the page has scrolled past it (as on every other page). The
  // black part: on desktop the hero and the six features; on phones and tablets the hero only (the features are on
  // white there).
  const head = document.querySelector<HTMLElement>("header[data-dark]");
  const heroSection = hero?.closest("section");
  if (head && wrap && heroSection) {
    let io: IntersectionObserver | null = null;
    const watch = () => {
      io?.disconnect();
      io = new IntersectionObserver(([e]) => (head.dataset.dark = e.isIntersecting ? "1" : "0"), {
        rootMargin: `-${head.offsetHeight}px 0px 0px 0px`,
      });
      io.observe(desktop.matches ? wrap : heroSection);
    };
    watch();
    desktop.addEventListener("change", watch);
  }

  if (hero) {
    const stretch = () => {
      hero.style.minHeight = "";
      if (wrap) wrap.style.minHeight = "";
      if (desktop.matches && wrap) {
        const top = wrap.getBoundingClientRect().top + scrollY;
        wrap.style.minHeight = `${Math.max(0, innerHeight - top)}px`;
      }
      if (!phone.matches) return;
      const top = hero.getBoundingClientRect().top + scrollY;
      hero.style.minHeight = `${Math.max(0, innerHeight - top)}px`;
    };
    stretch();
    let lastW = innerWidth;
    addEventListener("resize", () => {
      if (innerWidth === lastW) return;
      lastW = innerWidth;
      stretch();
    });
  }
</script>
