---
import Brand from "../components/Brand.astro";
import HeroChat from "../components/HeroChat.astro";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Highlights from "../components/Highlights.astro";
import Steps from "../components/Steps.astro";
import UseCases from "../components/UseCases.astro";
import Designed from "../components/Designed.astro";
import Testimonials from "../components/Testimonials.astro";
import BuyBox from "../components/BuyBox.astro";
import { languageCount } from "../lib/languages";
import { config, prices, formatPrice, shipCountryCodes } from "../config";
import heroBg from "../assets/home/hero-bg.png";
import heroWatch from "../assets/home/hero-watch.png";
import watchBox from "../assets/home/watch-box.png";

const description = `olacompanion is an AI smartwatch with a built-in voice assistant: tap the mic, talk naturally, set reminders, take notes and get live answers in ${languageCount} languages. ${formatPrice(prices.watch.GBP, "GBP")}, ships to the UK & EU.`;
const site = Astro.site!;
const heroImg = await getImage({ src: heroWatch, width: 1200, format: "png" });
const boxImg = await getImage({ src: watchBox, width: 1200, format: "png" });
const offerBase = {
  "@type": "Offer",
  url: new URL("/#buy", site).href,
  itemCondition: "https://schema.org/NewCondition",
  seller: { "@id": new URL("/#organization", site).href },
  hasMerchantReturnPolicy: {
    "@type": "MerchantReturnPolicy",
    applicableCountry: shipCountryCodes,
    returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
    merchantReturnDays: 14,
    returnMethod: "https://schema.org/ReturnByMail",
    returnFees: config.freeReturns ? "https://schema.org/FreeReturn" : "https://schema.org/ReturnFeesCustomerResponsibility",
  },
};
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": new URL("/#product", site).href,
    name: "olacompanion",
    description,
    image: [new URL(heroImg.src, site).href, new URL(boxImg.src, site).href],
    brand: { "@type": "Brand", name: config.siteName },
    manufacturer: { "@id": new URL("/#organization", site).href },
    category: "Smartwatches",
    additionalProperty: [
      { "@type": "PropertyValue", name: "Display", value: "AMOLED touch screen, 410 × 502 pixels" },
      { "@type": "PropertyValue", name: "Connectivity", value: "Wi-Fi (2.4 GHz)" },
      { "@type": "PropertyValue", name: "Languages", value: `${languageCount} + Auto` },
      { "@type": "PropertyValue", name: "Subscription", value: `olacare, ${formatPrice(prices.care.GBP, "GBP")}/month after ${prices.trialMonths} months free` },
    ],
    offers: [
      { ...offerBase, priceCurrency: "GBP", price: prices.watch.GBP.toFixed(2) },
      { ...offerBase, priceCurrency: "EUR", price: prices.watch.EUR.toFixed(2) },
    ],
  },
];
---
<Base title="AI smartwatch with a built-in voice assistant" description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
    <Image
      src={heroBg}
      alt=""
      widths={[768, 1280, 2000]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-white/85 via-white/55 to-white/10" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-6 pb-10 pt-10 lg:grid-cols-[1.15fr_1fr] lg:pb-14 lg:pt-12">
      <div>
        <h1 id="hero-title" class="hero-title font-extrabold leading-[1.08] tracking-tight text-fg sm:text-5xl lg:text-[3.4rem]">
          <span class="whitespace-nowrap">Your AI companion,</span><br /><span class="text-gradient whitespace-nowrap">now on your wrist.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-[#39415a]">
          Talk naturally. Get reminders, take notes, get live answers and more. <Brand name="watch" /> is an AI smartwatch designed to
          make everyday life easier, in {languageCount} languages.
        </p>
        <div class="mt-7 grid gap-3 sm:w-fit sm:grid-cols-2">
          <a href="#buy" class="btn btn-primary text-base sm:min-w-48">Buy Now <Icon name="arrow" size={18} /></a>
          <a href="/how-it-works/" class="btn btn-ghost text-base sm:min-w-48"><Icon name="play" size={20} class="text-accent" /> How It Works</a>
        </div>
      </div>
      <div class="relative mx-auto w-fit lg:-my-6 xl:-ml-16">
        <!-- phones and tablets: top right, beside the watch; desktop: lower left -->
        <p class="absolute -right-8 top-0 z-10 grid h-32 w-32 place-content-center gap-1 rounded-full bg-blue text-center font-display text-base font-extrabold uppercase leading-tight tracking-wide text-white shadow-[0_10px_28px_rgba(47,107,255,.4)] ring-4 ring-white/70 sm:-right-16 sm:h-36 sm:w-36 sm:text-lg lg:-left-10 lg:right-auto lg:top-[60%] lg:h-36 lg:w-36">
          <span>No App</span>
          <span>To Install</span>
        </p>
        <Image
          src={heroWatch}
          alt="The olacompanion (illustration)"
          widths={[360, 560, 760]}
          sizes="(min-width: 1024px) 440px, 80vw"
          loading="eager"
          fetchpriority="high"
          class="w-72 drop-shadow-[0_30px_40px_rgba(30,40,90,.35)] sm:w-80 lg:w-[27rem]"
        />
      </div>
      <HeroChat class="z-10 hidden xl:absolute xl:bottom-0 xl:top-10 xl:-right-24 xl:block xl:w-[21rem]" />
    </div>
  </section>

  <!-- Features -->
  <section class="bg-gradient-to-b from-[#f7f8ff] to-white pb-12 pt-6" aria-labelledby="features-title">
    <div class="container-x">
      <h2 id="features-title" class="sr-only">Features</h2>
      <Highlights />
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-bg-2 py-10" aria-labelledby="how-title">
    <div class="container-x">
      <h2 id="how-title" class="text-2xl font-extrabold tracking-tight text-fg">How <Brand name="watch" bold /> Works</h2>
      <p class="mt-1 text-muted">Get started in just a few simple steps.</p>
      <div class="mt-6"><Steps /></div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="container-x py-12" aria-labelledby="uses-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 id="uses-title" class="text-2xl font-extrabold tracking-tight text-fg sm:text-3xl">A Smarter Everyday, for Everyone</h2>
        <p class="mt-2 text-muted">
          <Brand name="watch" /> is designed for real life. Whether you're a parent, a professional, or just want a little extra
          support, <Brand name="watch" /> is always here to help.
        </p>
      </div>
      <a href="/features/" class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline">See More Use Cases <Icon name="arrow" size={16} /></a>
    </div>
    <div class="mt-6"><UseCases /></div>
  </section>

  <Designed />

  <Testimonials />

  <!-- Buy -->
  <section id="buy" class="bg-bg-2 py-12" aria-labelledby="buy-title">
    <div class="container-x grid items-center gap-8 lg:grid-cols-[16rem_minmax(0,1fr)_21rem]">
      <div>
        <p class="eyebrow">Get yours</p>
        <h2 id="buy-title" class="mt-1 text-3xl font-extrabold tracking-tight text-fg">Put <Brand name="watch" bold /> on Your Wrist</h2>
        <p class="mt-3 max-w-md text-muted">
          Get your <Brand name="watch" /> and be part of the next generation of AI-powered wearables.
        </p>
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-fg">
          <li class="flex items-center gap-2"><Icon name="rocket" size={18} class="text-accent" /> Early Access</li>
          <li class="flex items-center gap-2"><Icon name="gift" size={18} class="text-accent" /> <span>{prices.trialMonths} months of <Brand name="care" /> free</span></li>
          <li class="flex items-center gap-2"><Icon name="truck" size={18} class="text-accent" /> Ships to the UK &amp; EU</li>
        </ul>
      </div>
      <Image
        src={watchBox}
        alt="The olacompanion next to its box (illustration)"
        widths={[320, 520, 700]}
        sizes="(min-width: 1024px) 340px, 80vw"
        class="mx-auto w-72 lg:h-[446px] lg:!w-auto lg:max-w-full lg:overflow-visible lg:object-cover"
      />
      <BuyBox headingLevel="h3" compact anchor={false} />
    </div>
  </section>
</Base>

<script>
  // Offer availability follows the live shop status (/api/shop/status): only when checkout is open for a
  // currency does its Offer say InStock. Closed, unreachable or not configured: no availability at all
  // (never OutOfStock, which would be untrue). Matches the buy box, which uses the same status.
  import { shopStatus } from "../lib/shop";

  shopStatus().then((s) => {
    if (!s.open) return;
    for (const el of document.querySelectorAll<HTMLScriptElement>('script[type="application/ld+json"]')) {
      let data: unknown;
      try {
        data = JSON.parse(el.textContent || "");
      } catch {
        continue;
      }
      const items = Array.isArray(data) ? data : [data];
      let changed = false;
      for (const item of items as { "@type"?: string; offers?: { priceCurrency?: string; availability?: string }[] }[]) {
        if (item["@type"] !== "Product" || !Array.isArray(item.offers)) continue;
        for (const offer of item.offers) {
          if (offer.priceCurrency && s.currencies.includes(offer.priceCurrency.toLowerCase())) {
            offer.availability = "https://schema.org/InStock";
            changed = true;
          }
        }
      }
      if (changed) el.textContent = JSON.stringify(data);
    }
  });
</script>
