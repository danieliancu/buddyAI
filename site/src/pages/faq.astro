---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import { faqGroups, allFaqs } from "../data/faq";
import { config } from "../config";

const strip = (html: string) => html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqs.map((f) => ({
    "@type": "Question",
    name: strip(f.q),
    acceptedAnswer: { "@type": "Answer", text: strip(f.a) },
  })),
};
---
<Base
  title="FAQ: AI smartwatch questions answered"
  crumb="FAQ"
  description="Answers about the olawatch AI smartwatch: what it does, languages, privacy, price and the olacare subscription, delivery, returns and your legal rights."
  jsonLd={jsonLd}
>
  <PageHero eyebrow="FAQ" title="Questions," gradient="answered." />
  <div class="container-x mt-4 space-y-12">
    {faqGroups.map((g, i) => (
      <section aria-labelledby={`faq-${i}`}>
        <h2 id={`faq-${i}`} class="mb-4 text-xl font-bold text-fg">{g.title}</h2>
        <FaqList items={g.items} />
      </section>
    ))}
    <p class="text-muted">
      Still wondering? Email <a class="link" href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>.
    </p>
  </div>
</Base>
