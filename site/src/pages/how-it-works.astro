---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Steps from "../components/Steps.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { Image } from "astro:assets";
import watch from "../assets/home/designed-watch.png";
import Icon from "../components/Icon.astro";
import { config, prices } from "../config";
import { privacyLine } from "../data/features";

const journey = [
  { icon: "card" as const, title: "Order", text: `Pay for the watch with secure Stripe checkout and save your card for olácare. Nothing is charged for olácare yet: your free ${prices.trialMonths}-month trial starts when you pair the watch.` },
  { icon: "mail" as const, title: "Set your password", text: "We create your olá account with your checkout email and send you a link to set its password." },
  { icon: "truck" as const, title: "Delivery", text: "We email you tracking details when your watch ships." },
  { icon: "wifi" as const, title: "Connect to Wi-Fi", text: "Turn the watch on and sign in to your olá account. Android: tap “Connect to watch” and send your 2.4 GHz Wi-Fi to the watch over Bluetooth, from Chrome. iPhone: join the watch's network ola-XXXX with the password shown on the watch (or scan its QR code); a page opens where you pick your Wi-Fi and enter its password." },
  { icon: "display" as const, title: "Pair the watch", text: "The watch shows a 6-digit code. Type it in your olá account within 5 minutes. No app to install. Your free olácare trial starts now." },
  { icon: "persona" as const, title: "Make it yours", text: "In the watch's settings choose the language (or Auto), persona, voice and speaking speed, theme, brightness, volume, screen timeout and time zone." },
  { icon: "mic" as const, title: "Start talking", text: "Tap the mic button and ask a question, set a reminder or dictate a note. Notes, reminders, usage and billing are in your account." },
];
---
<Base title="How the olácompanion AI smartwatch works" crumb="How it works" description="Tap the mic, talk, and hear the AI answer out loud. How the olácompanion voice assistant works, from ordering and Wi-Fi setup to your first conversation.">
  <PageHero eyebrow="How it works" title="Tap. Talk." gradient="Listen." oneLineOnPhone fitEm={8.6} lead="No app to install, no wake words, no menus to learn. Set it up once, and one button on your wrist starts a conversation with your AI assistant." />

  <section class="container-x mt-6" aria-labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">Three steps</h2>
    <Steps />
  </section>

  <section class="container-x mt-20 grid items-center gap-10 lg:grid-cols-[1fr_1fr]" aria-labelledby="behind-title">
    <div>
      <SectionHeading id="behind-title" title="What happens when you talk" />
      <ol class="mt-6 space-y-4 text-muted">
        <li class="flex gap-3"><span class="font-bold text-violet">1.</span> You tap the mic button and speak. The watch records through its built-in microphones.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">2.</span> Your voice is sent securely over Wi-Fi and processed by our AI partners (OpenAI) to understand you and write a reply, shaped by the persona you chose.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">3.</span> The reply is turned into natural speech and played from the watch speaker, in your language.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">4.</span> Tap again at any time to interrupt. The conversation is saved to your account history, which you can export or delete anytime.</li>
      </ol>
      <p class="mt-6 text-sm text-muted">{privacyLine}</p>
    </div>
    <Image src={watch} alt="The olácompanion (illustration)" widths={[260, 420, 560, 960]} sizes="(min-width: 1024px) 480px, (min-width: 640px) 280px, 70vw" class="mx-auto w-60 sm:w-72 lg:h-[500px] lg:w-auto lg:max-w-none" />
  </section>

  <section class="container-x mt-20" aria-labelledby="journey-title">
    <SectionHeading id="journey-title" title="From order to first conversation" />
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {journey.map((j, i) => (
        <li class="glass p-5">
          <span class="icon-tile !h-10 !w-10"><Icon name={j.icon} size={20} /></span>
          <h3 class="mt-3 font-semibold text-fg"><span class="text-muted">{i + 1}.</span> {j.title}</h3>
          <p class="mt-1 text-sm text-muted">{j.text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-muted">Already have a watch? <a class="link" href={config.appUrl}>Sign in to your olá account</a>.</p>
  </section>
</Base>
