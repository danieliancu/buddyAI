---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import HowSimulator from "../components/how/HowSimulator.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { Image } from "astro:assets";
import watch from "../assets/home/designed-watch.png";
import { privacyLine } from "../data/features";
---
<Base title="How the olácompanion AI voice assistant works" crumb="How it works" description="Tap the mic, talk, and hear the AI answer out loud. How the olácompanion voice assistant works, from ordering and Wi-Fi setup to your first conversation.">
  <PageHero eyebrow="How it works" title="Tap. Talk." gradient="Listen." oneLine fitEm={8.6} lead="No app to install, no wake words, no menus to learn. Set it up once, and the top button on your wrist starts a conversation with your AI assistant." />

  <HowSimulator />

  <section class="container-x mt-20 grid items-center gap-10 lg:grid-cols-[1fr_1fr]" aria-labelledby="behind-title">
    <div>
      <SectionHeading id="behind-title" title="What happens when you talk" />
      <ol class="mt-6 space-y-4 text-muted">
        <li class="flex gap-3"><span class="font-bold text-violet">1.</span> You press the top button (or tap the mic) and speak. The watch records through its built-in microphones.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">2.</span> Your voice is sent securely over Wi-Fi and processed by our AI partners (OpenAI) to understand you and write a reply, shaped by the persona you chose.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">3.</span> The reply is turned into natural speech and played from the watch speaker, in your language.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">4.</span> Press again at any time to interrupt. The conversation is saved to your account history, which you can export or delete anytime.</li>
      </ol>
      <p class="mt-6 text-sm text-muted">{privacyLine}</p>
    </div>
    <Image src={watch} alt="The olácompanion (illustration)" widths={[260, 420, 560, 960]} sizes="(min-width: 1024px) 480px, (min-width: 640px) 280px, 70vw" class="mx-auto w-60 sm:w-72 lg:h-[500px] lg:w-auto lg:max-w-none" />
  </section>
</Base>
