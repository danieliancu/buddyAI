---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Steps from "../components/Steps.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WatchMock from "../components/WatchMock.astro";
import Icon from "../components/Icon.astro";
import { config, prices } from "../config";
import { privacyLine } from "../data/features";

const journey = [
  { icon: "card" as const, title: "Order", text: "Buy the watch with secure Stripe checkout. BuddyAI Care starts with " + prices.trialMonths + " months free." },
  { icon: "mail" as const, title: "Set your password", text: "Your confirmation email has a link to set your BuddyAI account password." },
  { icon: "truck" as const, title: "Delivery", text: "We email you tracking details when your watch ships." },
  { icon: "wifi" as const, title: "Add watch", text: "Sign in at the BuddyAI app, choose Add watch and connect it to Wi-Fi." },
  { icon: "mic" as const, title: "Start talking", text: "Tap the mic button. That's it." },
];
---
<Base title="How it works" description="Tap the mic, talk, and hear BuddyAI answer. Here's how the watch works, from ordering to your first conversation.">
  <PageHero eyebrow="How it works" title="Tap. Talk." gradient="Listen." lead="No wake words, no menus to learn. One button on your wrist starts a conversation with your AI assistant." />

  <section class="container-x mt-6" aria-labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">Three steps</h2>
    <Steps />
  </section>

  <section class="container-x mt-20 grid items-center gap-10 lg:grid-cols-[1fr_1fr]" aria-labelledby="behind-title">
    <div>
      <SectionHeading id="behind-title" title="What happens when you talk" />
      <ol class="mt-6 space-y-4 text-muted">
        <li class="flex gap-3"><span class="font-bold text-violet">1.</span> You tap the mic button and speak. The watch records through its built-in microphones.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">2.</span> Your voice is sent securely over Wi-Fi and processed by our AI partners (OpenAI) to understand you and write a reply, shaped by the persona you chose.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">3.</span> The reply is turned into natural speech and played from the watch speaker, in your language.</li>
        <li class="flex gap-3"><span class="font-bold text-violet">4.</span> Tap again at any time to interrupt. The conversation is saved to your account history, which you can export or delete anytime.</li>
      </ol>
      <p class="mt-6 text-sm text-muted">{privacyLine}</p>
    </div>
    <WatchMock id="how-watch" class="w-56 sm:w-64" />
  </section>

  <section class="container-x mt-20" aria-labelledby="journey-title">
    <SectionHeading id="journey-title" title="From order to first conversation" />
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {journey.map((j, i) => (
        <li class="glass p-5">
          <span class="icon-tile !h-10 !w-10"><Icon name={j.icon} size={20} /></span>
          <h3 class="mt-3 font-semibold text-white"><span class="text-muted">{i + 1}.</span> {j.title}</h3>
          <p class="mt-1 text-sm text-muted">{j.text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-muted">Already have a watch? <a class="link" href={config.appUrl}>Sign in to the BuddyAI app</a>.</p>
  </section>
</Base>
