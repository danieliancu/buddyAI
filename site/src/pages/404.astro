---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <section class="container-x py-24 text-center" aria-labelledby="nf-title">
    <p class="text-gradient text-7xl font-extrabold">404</p>
    <h1 id="nf-title" class="mt-4 text-3xl font-bold text-white">Page not found</h1>
    <p class="mt-3 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Go to home</a>
      <a href="/faq/" class="btn btn-ghost">Read the FAQ</a>
    </div>
  </section>
</Base>
