---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { config, legalLastUpdated, formatDate } from "../../config";

const policies = [
  { href: "/legal/terms-of-sale/", title: "Terms of sale", text: "The terms that apply when you buy an olácompanion: prices, payment, delivery, and how the contract is formed." },
  { href: "/legal/subscription-terms/", title: "Subscription terms", text: "olácare, the subscription that powers the AI assistant: price, free period, monthly AI interactions and cancelling." },
  { href: "/legal/returns/", title: "Returns & cancellation", text: "Your 14-day right to cancel, how to return the watch and how refunds work, with a model cancellation form." },
  { href: "/legal/warranty/", title: "Guarantee & warranty", text: "Your legal rights if the watch is faulty: UK statutory rights and the EU 2-year legal guarantee." },
  { href: "/legal/privacy/", title: "Privacy notice", text: "What personal data we collect, why, who we share it with, and your rights." },
  { href: "/legal/cookies/", title: "Cookie notice", text: "This website uses no tracking cookies. What is stored on your device, and why." },
];
---
<Base
  title="Legal & policies"
  crumb="Legal"
  description="olácompanion legal information in one place: terms of sale, subscription terms, returns and cancellation, guarantee and warranty, privacy and cookies."
>
  <PageHero
    eyebrow="Legal"
    title="Legal & policies"
    lead="The terms and policies that apply when you buy an olácompanion and use olácare, written to be read. Nothing here limits your statutory rights."
  />

  <section class="container-x mt-4" aria-label="Policies">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {policies.map((p) => (
        <li class="glass flex flex-col p-6">
          <h2 class="text-lg font-semibold text-fg"><a class="hover:underline" href={p.href}>{p.title}</a></h2>
          <p class="mt-2 flex-1 text-sm text-muted">{p.text}</p>
          <a class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline" href={p.href} aria-label={`Read: ${p.title}`}>
            Read <Icon name="arrow" size={16} />
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-muted">Last updated: <time datetime={legalLastUpdated}>{formatDate(legalLastUpdated)}</time></p>
  </section>

  <section class="container-x mt-12" aria-labelledby="legal-contact-title">
    <div class="glass grid gap-6 p-6 sm:p-8 md:grid-cols-[auto_1fr]">
      <span class="icon-tile"><Icon name="mail" /></span>
      <div>
        <h2 id="legal-contact-title" class="text-xl font-semibold text-fg">Questions about these policies</h2>
        <p class="mt-2 text-muted">
          Email <a class="link" href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a> for orders, cancellations,
          returns, guarantee claims and privacy requests.
        </p>
        <address class="mt-3 text-sm not-italic text-muted">
          {config.companyName}<br />
          {config.address}
          {config.companyNumber && <><br />Company number: {config.companyNumber}</>}
          {config.vatNumber && <><br />VAT number: {config.vatNumber}</>}
        </address>
      </div>
    </div>
  </section>
</Base>
