---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { languages, languageCount, languageCountLabel } from "../lib/languages";
---
<Base
  title={`Languages: an AI smartwatch that speaks ${languageCount} languages`}
  crumb="Languages"
  description={`The olacompanion voice assistant talks in ${languageCount} languages — English, the European languages and Ukrainian — plus Auto, which answers in the language you speak.`}
>
  <PageHero
    eyebrow="Languages"
    title={`${languageCountLabel} languages.`}
    lead={`olacompanion can talk with you in ${languageCount} languages. Choose one in your account, or pick Auto and it answers in whichever language you speak.`}
  />

  <section class="container-x mt-4" aria-labelledby="lang-title">
    <h2 id="lang-title" class="sr-only">All supported languages</h2>
    <ul class="grid grid-cols-1 gap-3 min-[420px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <li class="glass !border-violet/50 p-4">
        <p class="font-semibold text-fg">Auto</p>
        <p class="text-sm text-muted">Answers in the language you speak</p>
      </li>
      {languages.map((l) => (
        <li class="glass p-4">
          <p class="font-semibold text-fg" lang={l.code} dir={l.rtl ? "rtl" : "ltr"}>{l.native_name}</p>
          <p class="text-sm text-muted">{l.name}</p>
        </li>
      ))}
    </ul>
    <p class="mt-6 max-w-3xl text-sm text-muted">
      Speech recognition and voice quality vary between languages and accents, and are best in widely spoken languages.
      The list may change as our AI partners update their models.
    </p>
  </section>
</Base>
