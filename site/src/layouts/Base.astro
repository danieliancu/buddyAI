---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { config, prices, shipCountryCodes } from "../config";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Breadcrumb label for this page (defaults to the title). */
  crumb?: string;
}

const { title, description, noindex = false, jsonLd, crumb } = Astro.props;
const site = Astro.site ?? new URL("https://www.olacompanion.com");
const path = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/?$/, "/");
const canonical = new URL(path, site).href;
const fullTitle = path === "/" ? `${config.siteName} — ${title}` : `${title} | ${config.siteName}`;
const ogImage = new URL("/og-image.png", site).href;
const ogAlt = "olácompanion — the AI smartwatch with a voice assistant (illustration)";

// Structured data on every page: the organisation, the website, and breadcrumbs on inner pages.
const orgId = new URL("/#organization", site).href;
const siteData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": orgId,
    name: config.siteName,
    legalName: config.companyName,
    url: site.href,
    logo: new URL("/icon-512.png", site).href,
    email: config.supportEmail,
    address: { "@type": "PostalAddress", addressRegion: "Essex", addressCountry: "GB" },
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: config.supportEmail,
      areaServed: shipCountryCodes,
      availableLanguage: ["English"],
    },
    sameAs: config.social.map((s) => s.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": new URL("/#website", site).href,
    name: config.siteName,
    url: site.href,
    inLanguage: "en-GB",
    publisher: { "@id": orgId },
  },
];
if (path !== "/" && !noindex) {
  const parts = path.split("/").filter(Boolean);
  const name = (seg: string) => seg.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase());
  siteData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.href },
      ...parts.map((seg, i) => ({
        "@type": "ListItem",
        position: i + 2,
        name: i === parts.length - 1 ? (crumb ?? title) : name(seg),
        item: new URL("/" + parts.slice(0, i + 1).join("/") + "/", site).href,
      })),
    ],
  });
}
const pageData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allData = [...siteData, ...pageData];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content={config.companyName} />
    <meta name="application-name" content={config.siteName} />
    <link rel="alternate" hreflang="en-GB" href={canonical} />
    <link rel="alternate" hreflang="en-IE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(allData)} />}
    {config.plausibleDomain && (
      <script is:inline defer data-domain={config.plausibleDomain} src={config.plausibleSrc}></script>
    )}
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-white px-4 py-2 font-semibold text-black focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    <div class="hidden bg-[#ea580c] text-white sm:block">
      <p class="container-x flex min-h-8 items-center justify-center gap-2 py-1.5 text-xs font-semibold leading-none">
        <span class="leading-none">
          Free {prices.trialMonths}-month subscription<span class="mx-2 opacity-70" aria-hidden="true">·</span>AI voice assistant
          smartwatch<span class="mx-2 opacity-70" aria-hidden="true">·</span>No phone app needed
        </span>
      </p>
    </div>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
