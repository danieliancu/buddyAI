---
// The six features under the home page hero: no card or icon background, icons in the accent colour. On desktop
// (lg) they sit on the hero's black, on phones and tablets on white. Each one links to where it is explained.
import Icon from "./Icon.astro";
import { highlights } from "../data/features";
---
<ul class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-6">
  {highlights.map((f) => (
    <li class="text-center">
      <a href={f.href} class="group block rounded-2xl p-5">
        <Icon name={f.icon} size={44} class="mx-auto block text-accent transition-transform group-hover:-translate-y-0.5 lg:text-[#8b7bff]" />
        <h3 class="mt-4 text-sm font-bold text-fg group-hover:underline lg:text-white">{f.title}</h3>
        <p class="mt-1.5 text-xs leading-relaxed text-muted lg:text-white/65">{f.text}</p>
      </a>
    </li>
  ))}
</ul>
