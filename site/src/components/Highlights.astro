---
// The six feature cards under the home page hero.
import Icon from "./Icon.astro";
import { highlights } from "../data/features";
---
<ul class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-6">
  {highlights.map((f) => (
    <li class="glass p-5 text-center">
      <span class="icon-tile mx-auto" data-tint={f.tint}><Icon name={f.icon} /></span>
      <h3 class="mt-4 text-sm font-bold text-fg">{f.title}</h3>
      <p class="mt-1.5 text-xs leading-relaxed text-muted">{f.text}</p>
    </li>
  ))}
</ul>
