---
import Brand from "./Brand.astro";
import { prices } from "../config";
import Icon from "./Icon.astro";
import Price from "./Price.astro";
import CurrencyToggle from "./CurrencyToggle.astro";
import LegalFacts from "./LegalFacts.astro";
import PaymentLogos from "./PaymentLogos.astro";

interface Props {
  headingLevel?: "h2" | "h3";
  /** Home page card: the short version (no consumer-law list, which the pricing page shows). */
  compact?: boolean;
  /** Put id="buy" on the card (off when the surrounding section carries it). */
  anchor?: boolean;
}
const { headingLevel = "h2", compact = false, anchor = true } = Astro.props;
const H = headingLevel;
const trial = `free ${prices.trialMonths}-month subscription`;
---
<div id={anchor ? "buy" : undefined} class="glass relative p-6 sm:p-7" data-buybox>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <H class="text-xl font-bold text-fg"><Brand name="watch" bold /></H>
      <p class="mt-1 text-sm text-muted">AMOLED display · Voice AI · Built for everyday life</p>
    </div>
  </div>

  <div class="mt-5 flex items-end gap-3">
    <Price item="watch" class="font-display text-5xl font-extrabold tracking-tight text-fg" />
    <span class="pb-1.5 text-sm text-muted">one-off, VAT included</span>
  </div>

  <p class="mt-3 text-sm text-fg" data-price-sentence>
    Then <strong><Price item="care" />/month</strong> after your <strong>{trial}</strong>. Cancel anytime.
  </p>
  {!compact && (
    <p class="mt-2 text-sm text-muted">
      <Brand name="care" /> is the subscription that powers the AI assistant: it is needed for the watch to answer you. It
      includes a monthly fair-use allowance. See the <a class="link" href="/legal/subscription-terms/">subscription terms</a>.
    </p>
  )}

  <div class="mt-5">
    <button type="button" class="btn btn-primary w-full text-base" data-buy-btn>
      <span data-buy-label>Buy now</span>
      <Icon name="arrow" size={18} />
    </button>
    <PaymentLogos class="mt-3" />
    <div class="mt-2 min-h-5 text-sm" role="status" aria-live="polite" data-buy-status></div>
    <div id="notify-panel" class="mt-2 hidden rounded-xl border border-line-strong bg-bg-2 p-4" data-notify-panel>
      <p class="font-semibold text-fg">Sales open soon</p>
      <p class="mt-1 text-sm text-muted">We're getting ready to ship. Check back here soon — this button will turn into
        "Buy now" the moment sales open.</p>
    </div>
  </div>

  {compact ? (
    <p class="mt-1 text-xs text-muted">
      Ships to the UK &amp; EU · 14-day right to cancel ·
      <a class="link" href="/pricing/">Delivery, returns &amp; guarantee</a>
    </p>
  ) : (
    <LegalFacts class="mt-6 border-t border-line pt-6" />
  )}
</div>

<script>
  import { getCurrency } from "../lib/currency";
  import { shopStatus, canBuyIn, type ShopStatus } from "../lib/shop";

  const box = document.querySelector<HTMLElement>("[data-buybox]");
  if (box) {
    const btn = box.querySelector<HTMLButtonElement>("[data-buy-btn]")!;
    const label = box.querySelector<HTMLElement>("[data-buy-label]")!;
    const status = box.querySelector<HTMLElement>("[data-buy-status]")!;
    const panel = box.querySelector<HTMLElement>("[data-notify-panel]")!;
    let mode: "loading" | "buy" | "notify" = "loading";
    let shop: ShopStatus = { open: false, currencies: [] };

    const showError = (msg: string) => {
      status.innerHTML = "";
      const p = document.createElement("p");
      p.className = "text-danger";
      p.textContent = msg;
      status.append(p);
    };

    // Sales not open yet: the button keeps saying "Buy now" and opens the "Sales open soon" note.
    const setNotify = () => {
      mode = "notify";
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-controls", "notify-panel");
    };

    const statusPromise = shopStatus().then((s) => {
      shop = s;
      if (s.open) mode = "buy";
      else setNotify();
    });

    btn.addEventListener("click", async () => {
      if (mode === "loading") await statusPromise;
      if (mode === "notify") {
        const open = panel.classList.toggle("hidden") === false;
        btn.setAttribute("aria-expanded", String(open));
        return;
      }
      status.textContent = "";
      const currency = getCurrency();
      if (!canBuyIn(shop, currency)) {
        // The shop is open, but not in this currency yet: say so instead of a failed checkout.
        showError(`Checkout in ${currency === "GBP" ? "pounds" : "euros"} isn't available yet. Please check back soon.`);
        return;
      }
      btn.disabled = true;
      label.textContent = "Opening secure checkout…";
      try {
        const res = await fetch("/api/shop/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ currency: getCurrency().toLowerCase() }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) {
          const detail = typeof data.detail === "string" ? data.detail : "";
          throw new Error(detail || "Checkout is unavailable right now. Please try again in a moment.");
        }
        window.location.assign(data.url);
      } catch (e) {
        const msg = e instanceof Error && e.message && !/fetch|network/i.test(e.message)
          ? e.message
          : "We couldn't reach checkout. Check your connection and try again.";
        showError(msg);
        btn.disabled = false;
        label.textContent = "Buy now";
      }
    });
  }
</script>
