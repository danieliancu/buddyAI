---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  id?: string;
  center?: boolean;
}
const { title, subtitle, eyebrow, id, center = false } = Astro.props;
---
<div class:list={["max-w-3xl", center && "mx-auto text-center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-1 text-2xl font-bold tracking-tight text-fg sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 text-base text-muted sm:text-lg">{subtitle}</p>}
  <slot />
</div>
