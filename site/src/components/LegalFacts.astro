---
// Key consumer-law facts shown next to every buy box (and summarised in the FAQ).
import { config } from "../config";
import Icon from "./Icon.astro";
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---
<ul class={`grid gap-3 text-sm text-muted sm:grid-cols-2 ${cls}`}>
  <li class="flex gap-3">
    <Icon name="undo" size={20} class="mt-0.5 shrink-0 text-violet" />
    <span><strong class="text-fg">14-day right to cancel</strong> after delivery — change your mind for any reason
      (UK/EU distance-selling rules). <a class="link" href="/legal/returns/">Returns</a></span>
  </li>
  <li class="flex gap-3">
    <Icon name="shield" size={20} class="mt-0.5 shrink-0 text-violet" />
    <span><strong class="text-fg">Your legal rights</strong>: UK statutory rights, and a 2-year legal guarantee in
      the EU. <a class="link" href="/legal/warranty/">Guarantee</a></span>
  </li>
  <li class="flex gap-3">
    <Icon name="truck" size={20} class="mt-0.5 shrink-0 text-violet" />
    <span><strong class="text-fg">Ships to the UK and EU</strong>. {config.shipping.costNote}
      {config.freeReturns ? " Free returns." : ""}</span>
  </li>
  <li class="flex gap-3">
    <Icon name="lock" size={20} class="mt-0.5 shrink-0 text-violet" />
    <span><strong class="text-fg">Secure checkout</strong> by Stripe. Prices include VAT.</span>
  </li>
</ul>
