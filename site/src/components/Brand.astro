---
// The product names as one word (see lib/brand.ts). `bold`: set bold like the logo, with its leaf.
import { brandHtml, type BrandName } from "../lib/brand";
interface Props {
  name: BrandName;
  bold?: boolean;
}
---
<Fragment set:html={brandHtml(Astro.props.name, { bold: Astro.props.bold })} />