---
import Icon from "./Icon.astro";
import { features } from "../data/features";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---
<ul class:list={["grid gap-4", detailed ? "sm:grid-cols-2 lg:grid-cols-3" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"]}>
  {features.map((f) => (
    <li class:list={["glass p-5", !detailed && "xl:text-center"]}>
      <span class:list={["icon-tile", !detailed && "xl:mx-auto"]}><Icon name={f.icon} /></span>
      <h3 class="mt-4 font-semibold text-white">{f.title}</h3>
      <p class="mt-1.5 text-sm text-muted">{detailed ? f.long : f.short}</p>
    </li>
  ))}
</ul>
