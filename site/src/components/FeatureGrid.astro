---
import Icon from "./Icon.astro";
import { features } from "../data/features";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---
<ul class:list={["grid gap-4", detailed ? "sm:grid-cols-2 lg:grid-cols-3" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"]}>
  {features.map((f) => (
    <li class:list={["glass flex items-center gap-4 p-5 sm:block", !detailed && "xl:text-center"]}>
      <span class:list={["icon-tile shrink-0", !detailed && "xl:mx-auto"]}><Icon name={f.icon} /></span>
      <div class="min-w-0">
        <h3 class="font-semibold text-fg sm:mt-4">{f.title}</h3>
        <p class="mt-1.5 text-sm text-muted">{detailed ? f.long : f.short}</p>
      </div>
    </li>
  ))}
</ul>
