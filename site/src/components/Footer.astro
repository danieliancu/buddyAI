---
import { config } from "../config";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import PaymentLogos from "./PaymentLogos.astro";

const year = new Date().getFullYear();
const cols = [
  {
    title: "Product",
    links: [
      { href: "/features/", label: "Features" },
      { href: "/how-it-works/", label: "How it works" },
      { href: "/pricing/", label: "Pricing" },
      { href: "/languages/", label: "Languages" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about/", label: "About" },
      { href: "/contact/", label: "Contact" },
      { href: "/faq/", label: "FAQ" },
      { href: config.appUrl, label: "Sign in" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/legal/terms-of-sale/", label: "Terms of sale" },
      { href: "/legal/subscription-terms/", label: "Subscription terms" },
      { href: "/legal/privacy/", label: "Privacy" },
      { href: "/legal/cookies/", label: "Cookies" },
      { href: "/legal/returns/", label: "Returns & cancellation" },
      { href: "/legal/warranty/", label: "Guarantee & warranty" },
    ],
  },
];
---
<footer class="site-footer mt-24 bg-[#0b1028] text-[#aab3cc]">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1.6fr]">
    <div>
      <a href="/" aria-label="ola home" class="inline-block rounded-lg"><Logo size="lg" light /></a>
      <p class="mt-4 max-w-xs text-sm">An AI voice companion on your wrist. Designed for the UK and Europe.</p>
      <PaymentLogos class="mt-5" align="start" dark />
    </div>

    {cols.map((col) => (
      <nav aria-label={col.title}>
        <h2 class="text-sm font-semibold text-white">{col.title}</h2>
        <ul class="mt-3 space-y-2">
          {col.links.map((l) => (
            <li><a href={l.href} class="text-sm hover:text-white">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div>
      <h2 class="text-sm font-semibold text-white">Join our journey</h2>
      {config.newsletterAction ? (
        <form action={config.newsletterAction} method="post" class="mt-3">
          <label for="nl-email" class="text-sm">Get launch news by email. Unsubscribe anytime.</label>
          <div class="mt-2 flex rounded-xl border border-white/15 bg-white/5 p-1 focus-within:ring-2 focus-within:ring-blue-300">
            <input
              id="nl-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="Enter your email"
              class="min-w-0 flex-1 bg-transparent px-3 text-sm text-white placeholder:text-[#7e88a3] focus:outline-none"
            />
            <button type="submit" class="btn btn-primary !min-h-10 !px-3" aria-label="Subscribe">
              <Icon name="arrow" size={18} />
            </button>
          </div>
          <p class="mt-2 text-xs">See our <a class="link" href="/legal/privacy/">privacy notice</a>.</p>
        </form>
      ) : (
        <div class="mt-3 text-sm">
          <p>Sales open soon. Check back here for launch news, or write to us at
            <a class="text-white underline underline-offset-2" href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>.</p>
        </div>
      )}
      {config.social.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-3">
          {config.social.map((s) => (
            <li><a class="text-sm hover:text-white" href={s.href} rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs md:flex-row md:items-center md:justify-between">
      <p>© {year} {config.companyName}. All rights reserved.</p>
      <p>{config.address} · <a class="hover:text-white" href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>{config.companyNumber && <> · Company no. {config.companyNumber}</>}{config.vatNumber && <> · VAT {config.vatNumber}</>}</p>
    </div>
  </div>
</footer>
