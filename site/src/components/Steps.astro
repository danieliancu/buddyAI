---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import watch from "../assets/home/hero-watch.png";
import { brandHtml } from "../lib/brand";

const olacompanion = brandHtml("watch");

const steps = [
  {
    title: "Wear It",
    text: `Connect your ${olacompanion} to Wi-Fi and link it to your account with a 6-digit code.`,
  },
  {
    title: "Talk Naturally",
    text: "Tap the mic and ask a question, set a reminder or dictate a note.",
  },
  {
    title: "Get Things Done",
    text: `${olacompanion} answers out loud, in your language, right from your wrist.`,
  },
];
---
<ol class="grid gap-6 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-center">
  {steps.map((s, i) => (
    <>
      <li class="flex items-center gap-5">
        <span class="relative grid h-24 w-24 shrink-0 place-items-center rounded-full md:overflow-hidden md:bg-white md:shadow-[0_4px_16px_rgba(40,50,120,.1)]" aria-hidden="true">
          {/* phones: no white circle behind the icons; the watch is drawn larger than its circle (absolute, so the spacing stays the same) */}
          {i === 0 && <Image src={watch} alt="" width={320} class="absolute left-1/2 top-1/2 h-32 w-32 max-w-none -translate-x-1/2 -translate-y-1/2 object-contain drop-shadow-[0_10px_16px_rgba(30,40,90,.3)] md:static md:h-20 md:w-20 md:translate-x-0 md:translate-y-0 md:drop-shadow-none" />}
          {i === 1 && <Icon name="wave" size={44} class="text-accent" />}
          {i === 2 && (
            <span class="grid h-16 w-16 place-items-center rounded-full bg-accent text-white"><Icon name="check" size={34} /></span>
          )}
        </span>
        <div class="min-w-0">
          <h3 class="text-base font-bold text-fg"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
          <p class="mt-1 text-sm text-muted" set:html={s.text} />
        </div>
      </li>
      {i < steps.length - 1 && (
        <li aria-hidden="true" class="hidden text-[#a9b4ff] md:block"><Icon name="chevronRight" size={28} /></li>
      )}
    </>
  ))}
</ol>
