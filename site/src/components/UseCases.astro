---
import { Image } from "astro:assets";
import parents from "../assets/home/use-parents.png";
import kids from "../assets/home/use-kids.png";
import professionals from "../assets/home/use-professionals.png";
import productivity from "../assets/home/use-productivity.png";

const cases = [
  {
    img: parents,
    alt: "A mother and daughter smiling at the watch (illustration)",
    title: "For Busy Parents",
    text: "Stay organised, set reminders, and get quick answers on the go.",
  },
  {
    img: kids,
    alt: "A boy tapping the watch on his wrist (illustration)",
    title: "For Curious Minds",
    text: "Ask anything together and hear a clear, spoken answer.",
  },
  {
    img: professionals,
    alt: "A man in a suit checking the watch (illustration)",
    title: "For Professionals",
    text: "Reminders, notes and live answers, hands-free.",
  },
  {
    img: productivity,
    alt: "A woman resting her arms, the watch on her wrist (illustration)",
    title: "For Everyday Productivity",
    text: "Notes, reminders, answers and more — right on your wrist.",
  },
];
---
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {cases.map((c) => (
    <li class="relative h-56 overflow-hidden rounded-xl bg-bg-2 shadow-[0_8px_24px_rgba(40,50,120,.1)]">
      <Image src={c.img} alt={c.alt} widths={[360, 560, 720]} sizes="(min-width: 1024px) 280px, (min-width: 640px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/40 to-transparent p-4 pt-14">
        <h3 class="text-base font-bold text-white">{c.title}</h3>
        <p class="mt-1 text-sm leading-snug text-white/90">{c.text}</p>
      </div>
    </li>
  ))}
</ul>
