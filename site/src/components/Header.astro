---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { config } from "../config";

const nav = [
  { href: "/", label: "Home" },
  { href: "/features/", label: "Features" },
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/about/", label: "About" },
];
const mobileExtra = [
  { href: "/languages/", label: "Languages" },
  { href: "/faq/", label: "FAQ" },
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
const isActive = (href: string) => path === href;
---
<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-2">
      <slot name="start" />
      <a href="/" class="flex items-center gap-2 rounded-lg" aria-label="ola home">
        <Logo />
      </a>
    </div>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-accent",
                isActive(item.href) ? "text-accent" : "text-fg",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={config.appUrl}
        class="hidden h-10 w-10 place-items-center rounded-full text-fg hover:bg-bg-2 sm:grid"
        aria-label="Sign in to your ola account"
        title="Sign in"
      >
        <Icon name="user" size={20} />
      </a>
      <a href="/#buy" class="btn btn-primary hidden !min-h-10 !px-5 !py-2 text-sm sm:inline-flex" >
        Buy now
      </a>
      <button
        type="button"
        class="inline-grid h-11 w-11 place-items-center rounded-xl border border-line text-fg lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="sr-only">Open menu</span>
        <span data-icon-open><Icon name="menu" /></span>
        <span data-icon-close hidden><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <!-- over the page (it doesn't push the content down), scrolls on its own when taller than the screen -->
  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-y border-line bg-white shadow-[0_18px_40px_rgba(15,21,51,.16)] lg:hidden"
    hidden
  >
    <ul class="container-x flex flex-col py-3">
      {[...nav, ...mobileExtra].map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block rounded-lg px-2 py-3 text-base font-medium",
              isActive(item.href) ? "text-accent" : "text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li><a href={config.appUrl} class="block rounded-lg px-2 py-3 text-base font-medium text-fg">Sign in</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.getElementById("mobile-nav");
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      btn.querySelector<HTMLElement>("[data-icon-open]")!.hidden = open;
      btn.querySelector<HTMLElement>("[data-icon-close]")!.hidden = !open;
      btn.querySelector(".sr-only")!.textContent = open ? "Close menu" : "Open menu";
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    // a tap outside the menu (or on one of its links, e.g. /#buy on the home page) closes it
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (btn.getAttribute("aria-expanded") === "true" && !btn.contains(t) && (!menu.contains(t) || (t as Element).closest?.("a")))
        set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        set(false);
        btn.focus();
      }
    });
  }
</script>
