---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { config } from "../config";

const nav = [
  { href: "/", label: "Home" },
  { href: "/features/", label: "Features" },
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/about/", label: "About" },
];
const mobileExtra = [
  { href: "/languages/", label: "Languages" },
  { href: "/faq/", label: "FAQ" },
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
const isActive = (href: string) => path === href;
---
<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 rounded-lg" aria-label="ola home">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-accent",
                isActive(item.href) ? "text-accent" : "text-fg",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={config.appUrl}
        class="hidden h-10 w-10 place-items-center rounded-full text-fg hover:bg-bg-2 sm:grid"
        aria-label="Sign in to your ola account"
        title="Sign in"
        data-account-out
      >
        <Icon name="user" size={20} />
      </a>
      <a
        href={`${config.appUrl}/my`}
        class="hidden max-w-40 items-center gap-1.5 rounded-lg px-1.5 py-1 text-fg hover:bg-bg-2"
        title="Your ola account (signed in)"
        data-account-in
      >
        <Icon name="lock" size={20} class="shrink-0 text-ok" />
        <span class="flex min-w-0 flex-col text-[11px] font-medium leading-tight">
          <span class="truncate" data-account-name></span>
          <span class="truncate text-muted" data-account-last></span>
        </span>
        <span class="sr-only">, signed in</span>
      </a>
      <a href="/#buy" class="btn btn-primary hidden !min-h-10 !px-5 !py-2 text-sm sm:inline-flex" data-header-buy>
        Buy now
      </a>
      <button
        type="button"
        class="inline-grid h-11 w-11 place-items-center rounded-xl border border-line text-fg lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="sr-only">Open menu</span>
        <span data-icon-open><Icon name="menu" /></span>
        <span data-icon-close hidden><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <!-- over the page (it doesn't push the content down), scrolls on its own when taller than the screen -->
  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-y border-line bg-white shadow-[0_18px_40px_rgba(15,21,51,.16)] lg:hidden"
    hidden
  >
    <ul class="container-x flex flex-col py-3">
      {[...nav, ...mobileExtra].map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block rounded-lg px-2 py-3 text-base font-medium",
              isActive(item.href) ? "text-accent" : "text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li data-account-out-mobile><a href={config.appUrl} class="block rounded-lg px-2 py-3 text-base font-medium text-fg">Sign in</a></li>
      <li class="hidden" data-account-in-mobile>
        <a href={`${config.appUrl}/my`} class="flex items-center gap-2 rounded-lg px-2 py-3 text-base font-medium text-fg">
          <Icon name="lock" size={18} class="text-ok" /><span data-account-full></span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<!-- Before the first paint: show the remembered signed-in state at once (no "Buy now" flash on refresh);
     the check against the account below confirms or clears it. -->
<script is:inline>
  window.__olaBadge = function (b) {
    var signedIn = !!(b && b.signedIn);
    var q = function (s) { return document.querySelector(s); };
    var all = function (s, f) { document.querySelectorAll(s).forEach(f); };
    if (signedIn) {
      all("[data-account-name]", function (el) { el.textContent = b.name; });
      all("[data-account-last]", function (el) { el.textContent = b.lastName || ""; });
      all("[data-account-full]", function (el) { el.textContent = (b.name + " " + (b.lastName || "")).trim(); });
    }
    var buy = q("[data-header-buy]"), out = q("[data-account-out]"), inn = q("[data-account-in]");
    if (buy) buy.classList.toggle("sm:inline-flex", !signedIn); // already a customer: no "Buy now"
    if (out) out.classList.toggle("sm:grid", !signedIn);
    if (inn) inn.classList.toggle("sm:inline-flex", signedIn);
    var om = q("[data-account-out-mobile]"), im = q("[data-account-in-mobile]");
    if (om) om.classList.toggle("hidden", signedIn);
    if (im) im.classList.toggle("hidden", !signedIn);
  };
  try {
    var cached = JSON.parse(localStorage.getItem("ola.badge") || "null");
    if (cached && cached.signedIn) window.__olaBadge(cached);
  } catch (e) {}
</script>

<script>
  import { fetchBadge } from "../lib/account";
  import { config as siteConfig } from "../config";

  // Signed in to the ola account: green lock + name instead of "Sign in" (and no "Buy now"). The answer is
  // remembered on this device so the next page shows it before the first paint (inline script above).
  void fetchBadge(siteConfig.appUrl).then((b) => {
    (window as unknown as { __olaBadge?: (x: unknown) => void }).__olaBadge?.(b);
    try {
      if (b.signedIn) localStorage.setItem("ola.badge", JSON.stringify(b));
      else localStorage.removeItem("ola.badge");
    } catch {
      /* private mode: the header just updates a moment later */
    }
  });

  const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.getElementById("mobile-nav");
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      btn.querySelector<HTMLElement>("[data-icon-open]")!.hidden = open;
      btn.querySelector<HTMLElement>("[data-icon-close]")!.hidden = !open;
      btn.querySelector(".sr-only")!.textContent = open ? "Close menu" : "Open menu";
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    // a tap outside the menu (or on one of its links, e.g. /#buy on the home page) closes it
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (btn.getAttribute("aria-expanded") === "true" && !btn.contains(t) && (!menu.contains(t) || (t as Element).closest?.("a")))
        set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        set(false);
        btn.focus();
      }
    });
  }
</script>
